# Node
node_modules/
dist/
.next/
out/

# Any env file except the committed examples. `.env` / `.env.local` alone missed
# .env.production and friends.
.env*
!.env.example

# Java / Spring Boot
target/
*.war
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Claude Code (personal local config, not shared with team)
/.claude/
/CLAUDE.md

# Scratch files from local tooling. Six of these were committed to the repo root
# before this rule existed (one-off scripts and a 317 KB diff dump), and eight
# more later (PR diff dumps, throwaway Java classes, a shell error log named "null").
/*.py
/*_diff.txt
/*.diff
/*.patch
/*.java
/*.class
/pr_body.txt
/null

# Spring profiles holding real credentials. application-supabase.yml was committed
# with the production database password; keep such profiles local, or better,
# read them from environment variables.
/backend/src/main/resources/application-supabase.yml
/backend/src/main/resources/application-*-local.yml

# Local database dumps — never commit member data
/backend/backups/
*.dump

# Internal audit reports. Kept out of the repository because this repo is public
# and the security audit documents findings, affected files and attack paths.
# The reports still exist locally in documents/audits/ — they are simply not shared.
/documents/audits/

# Python test cache
__pycache__/
