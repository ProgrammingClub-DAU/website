# Backend environment variables
#
# Copy to `.env` for local use, or set these in the hosting dashboard for a
# deployment. Every variable the application reads is listed here — if it is not
# in this file, the code does not read it.

# ── Database ──────────────────────────────────────────────────────────────────
# NOTE: Spring reads SPRING_DATASOURCE_URL, *not* DATABASE_URL. Render and some
# other providers auto-inject a variable named DATABASE_URL containing a URI like
# `postgres://user:pass@host:5432/db`. Spring's JDBC driver cannot parse that
# form, so it must be rewritten and split into the three variables below:
#
#   postgres://alice:secret@db.example.com:5432/cpclub
#     ->  SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/cpclub
#         SPRING_DATASOURCE_USERNAME=alice
#         SPRING_DATASOURCE_PASSWORD=secret
#
# Required by the `prod` profile — the app will not start without them.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cpclub_db
SPRING_DATASOURCE_USERNAME=cpclub_user
SPRING_DATASOURCE_PASSWORD=cpclub_password

# ── Security ──────────────────────────────────────────────────────────────────
# Required. No default — the application fails fast at startup if this is unset,
# which is deliberate: a fallback secret would let anyone who reads the repository
# forge a token for any account, including an admin.
#
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# How long an issued token stays valid, in milliseconds. Default 86400000 (24h).
APP_JWT_EXPIRATION_MS=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. MUST include the deployed
# frontend URL, or reads keep working (server-side, CORS-exempt) while every
# browser-side write — login, register, editing a handle — fails preflight.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Scheduling ────────────────────────────────────────────────────────────────
# Spring cron for the Codeforces rating sync. Default is every 6 hours.
# Note this is an in-process timer: it does not fire while the instance is asleep
# on a platform that spins down idle services.
CPCLUB_CODEFORCES_SYNC_CRON=0 0 */6 * * *

# ── Profile ───────────────────────────────────────────────────────────────────
# Set to `prod` in any deployment. The Dockerfile already bakes this in; it is
# listed here so the requirement is discoverable outside the container.
SPRING_PROFILES_ACTIVE=prod
