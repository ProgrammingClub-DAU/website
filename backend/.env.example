# Backend environment variables
#
# Copy to `.env` for local use, or set these in the hosting dashboard for a
# deployment. Every variable the application reads is listed here — if it is not
# in this file, the code does not read it.

# ── Database ──────────────────────────────────────────────────────────────────
# NOTE: Spring reads SPRING_DATASOURCE_URL, *not* DATABASE_URL. Render and some
# other providers auto-inject a variable named DATABASE_URL containing a URI like
# `postgres://user:pass@host:5432/db`. Spring's JDBC driver cannot parse that
# form, so it must be rewritten and split into the three variables below:
#
#   postgres://alice:secret@db.example.com:5432/cpclub
#     ->  SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/cpclub
#         SPRING_DATASOURCE_USERNAME=alice
#         SPRING_DATASOURCE_PASSWORD=secret
#
# Required by the `prod` profile — the app will not start without them.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cpclub_db
SPRING_DATASOURCE_USERNAME=cpclub_user
SPRING_DATASOURCE_PASSWORD=cpclub_password

# ── Security ──────────────────────────────────────────────────────────────────
# Required. No default — the application fails fast at startup if this is unset,
# which is deliberate: a fallback secret would let anyone who reads the repository
# forge a token for any account, including an admin.
#
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# How long an issued token stays valid, in milliseconds. Default 86400000 (24h).
APP_JWT_EXPIRATION_MS=86400000

# -- Google sign-in -----------------------------------------------------------
# REQUIRED. No default -- the application fails to start without it, which is
# deliberate: the alternative is booting with the only way in quietly broken.
#
# Must be the SAME OAuth 2.0 Web client ID the frontend is built with. Every ID
# token is checked to have been issued for this client, so a mismatch refuses
# every sign-in with no obvious cause. Not a secret; see frontend/.env.example
# for how to create it.
GOOGLE_CLIENT_ID=

# The only email domain allowed to sign in. Checked twice against each token:
# once against the address, once against Google's `hd` hosted-domain claim, which
# is what distinguishes a real university account from a personal one wearing a
# similar address.
#
# Changing this opens the club's site to another domain. Do it deliberately.
GOOGLE_ALLOWED_DOMAIN=dau.ac.in

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. MUST include the deployed
# frontend URL, or reads keep working (server-side, CORS-exempt) while every
# browser-side write — signing in, editing a handle — fails preflight.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Scheduling ────────────────────────────────────────────────────────────────
# All scheduled crons (syncs, snapshots, totals, reminders) run in this timezone.
# Default is Asia/Kolkata. UTC on Render without this setting means the Monday
# snapshot fires at 05:30 IST instead of 00:00 IST.
CPCLUB_SCHEDULING_ZONE=Asia/Kolkata

# Spring cron for the Codeforces rating and submission sync. Default every 6 hours.
CPCLUB_CODEFORCES_SYNC_CRON=0 0 */6 * * *

# Spring cron for the weekly rating snapshot. Default midnight every Monday.
CPCLUB_SNAPSHOT_CRON=0 0 0 * * MON

# ── Phase 3 Toggles ──────────────────────────────────────────────────────────
# Set these in production to turn on Phase 3 features once they are built.

# Enables Codeforces submission backfills and incremental syncs.
CPCLUB_CF_SUBMISSIONS_ENABLED=false
# Authorized Codeforces API keys (needed for club contest syncing)
CF_API_KEY=
CF_API_SECRET=

# Enables fetching upcoming external contest schedules (CF, LC, AtCoder, CodeChef)
CPCLUB_EXTERNAL_CONTESTS_ENABLED=false
# Optional: fallback API key for clist.by if direct scrapers break
CLIST_API_KEY=

# Overrides the default allowed email domain for Phase 3's email features
CPCLUB_AUTH_ALLOWED_EMAIL_DOMAINS=dau.ac.in

# Enables outbound reminder emails (Stage 5B/6B)
CPCLUB_MAIL_ENABLED=false
CPCLUB_MAIL_FROM=no-reply@localhost
# Required if mail is enabled: signs the one-click unsubscribe links.
# Generate with: openssl rand -hex 32
CPCLUB_UNSUBSCRIBE_SECRET=

# The public URL of the frontend (e.g. https://cpclub.vercel.app), used in
# emails to generate absolute links back to the site.
CPCLUB_PUBLIC_SITE_URL=http://localhost:3000

# ── Profile ───────────────────────────────────────────────────────────────────
# Set to `prod` in any deployment. The Dockerfile already bakes this in; it is
# listed here so the requirement is discoverable outside the container.
SPRING_PROFILES_ACTIVE=prod

